    {
      "name": "Rental",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const pad = function (n) { return String(n).padStart(2, '0'); };",
              "const iso = function (d) { return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()); };",
              "const now = new Date();",
              "pm.collectionVariables.set('hariIni', iso(now));",
              "pm.collectionVariables.set('tanggalMulai', iso(now));",
              "pm.collectionVariables.set('tanggalSelesai', iso(new Date(now.getTime() + 2 * 86400000)));"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "Ajukan Rental",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.test('Status pending', function () { pm.expect(body.data.status).to.eql('pending'); });",
                  "pm.test('Total sewa dihitung', function () { pm.expect(body.data.total_sewa).to.be.a('string'); });",
                  "pm.collectionVariables.set('rentalId', body.data.id_rental);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
